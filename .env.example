# Create a NEW Supabase project for Ehyaa. Keep the student database separate from every other platform.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Email of the teacher account created in the new Supabase project
VITE_TEACHER_ACCOUNT_EMAIL=teacher@ehyaa.app
